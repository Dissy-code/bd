{
  "info": {
    "name": "Notes API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /notes - 200 OK",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notes",
          "host": ["{{base_url}}"],
          "path": ["notes"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /notes?id_user=abc - 400 Bad Request",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notes?id_user=abc",
          "host": ["{{base_url}}"],
          "path": ["notes"],
          "query": [{ "key": "id_user", "value": "abc" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Body contains error message', function () {",
              "    pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /notes - valid JSON",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notes",
          "host": ["{{base_url}}"],
          "path": ["notes"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response is valid JSON', function () {",
              "    pm.response.to.be.json;",
              "    pm.expect(function () { pm.response.json(); }).to.not.throw();",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "note": "Тест на 500 требует временно переименовать notes.json на сервере (например, через скрипт на стороне сервера) — Postman сам этого вызвать не может, поэтому отдельного пункта на 500 здесь нет."
}
